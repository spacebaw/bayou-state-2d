{
  "name": "bayou-state-2d",
  "version": "1.0.0",
  "description": "Bayou State 2D — Handcrafted HD Isometric Canvas University-in-a-Swamp Simulation",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@capacitor/ios": "^8.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  }
}
